# Clerk — development instance.
# Only the publishable key belongs on a mobile client; it ships in the app bundle.
# Pull real values with: clerk env pull --file apps/web/.env.local
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Our backend. Leave unset in development: the API base URL is derived from the
# Expo dev server's host, which is correct on a simulator, an emulator and a
# physical device alike. Set it for staging/production builds.
# EXPO_PUBLIC_API_URL=https://api.example.com
