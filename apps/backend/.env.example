# Clerk — development instance keys.
# Pull real values with: clerk env pull --file apps/web/.env.local
CLERK_SECRET_KEY=sk_test_xxx

# Origins allowed to present a Clerk token to this API. Without this, a JWT
# minted for a different Clerk application would verify here.
#
# LEFT UNSET ON PURPOSE until we have confirmed what `azp` real web and Expo
# clients actually send. Tokens minted through Clerk's Backend API carry no
# `azp` at all, and turning this on would reject them — verify against real
# clients on both platforms before enabling it anywhere.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Local Postgres from docker-compose.yml at the repo root.
DATABASE_URL=postgresql://student_monitor:student_monitor@localhost:5433/student_monitor?schema=public

PORT=3001
