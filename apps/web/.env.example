# Clerk — development instance.
# Pull real values with: clerk env pull --file apps/web/.env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Point Clerk at our own routes. Without these, redirectToSignIn() sends users
# to the Clerk-hosted account portal and the local sign-in pages are dead code.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/panel
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/panel

# Our backend. Server-side only — deliberately not NEXT_PUBLIC, because the
# token minted alongside it must never reach the browser.
API_URL=http://localhost:3001
